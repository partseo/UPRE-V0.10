{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upre.local/schemas/observation.schema.json",
  "title": "UPRE Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "source_adapter", "subject_ref", "observation_type", "raw_value", "normalized_value", "evidence_ids", "confidence", "captured_at"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^OB-[A-Za-z0-9._-]+$"},
    "source_adapter": {"$ref": "#/$defs/sourceAdapter"},
    "subject_ref": {"$ref": "program-model.schema.json#/$defs/entityRef"},
    "observation_type": {"type": "string", "minLength": 1},
    "raw_value": {},
    "normalized_value": {},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sourceAdapter": {
      "enum": ["WEB_DOM", "WEB_ACCESSIBILITY", "WEB_NETWORK", "WINDOWS_UIA", "WINDOWS_WIN32", "WINDOWS_ACCESSIBILITY", "VISION", "SOURCE_AST", "SOURCE_PATTERN", "DOCUMENT", "RUNTIME", "USER", "RULE_ENGINE", "AI_INFERENCE", "OSS_IMPORT"]
    }
  }
}
